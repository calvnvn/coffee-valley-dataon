<!-- views/catalog.ejs -->
<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="content-container">
    <table class="catalog-table">
        <thead>
            <tr>
                <th style="width: 20%; text-align: left;">Bean</th>
                <th style="width: 65%; text-align: left;">Description</th>
                <th style="width: 15%; text-align: right;">Price/Unit</th>
            </tr>
        </thead>
        <tbody>
            <% if (beans && beans.length > 0) { %>
                <% beans.forEach(bean => { %>
                    <tr>
                        <td class="bean-title-col">
                            <strong><%= bean.bean_name %></strong>
                        </td>
                        <td class="bean-desc-col">
                            <%= bean.description %>
                        </td>
                        <td class="bean-price-col">
                            $<%= Number(bean.price_per_unit).toFixed(2) %>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="3" style="text-align: center; padding: 20px;">
                        Tidak ada data kopi di katalog.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<%- include('partials/footer') %>
